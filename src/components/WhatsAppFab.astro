---
/** Floating WhatsApp button — phones and tablets only (issue #5). */
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { waLink } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<a class="wa-fab mono" href={waLink(lang)} target="_blank" rel="noopener" aria-label={t('wa.fab')} title={t('wa.fab')} data-cursor="WA">
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"
      d="M4 20l1.3-3.9A8 8 0 1 1 8 19.1L4 20z"></path>
    <path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" d="M9 10h6M9 13h4"></path>
  </svg>
  <span>WA</span>
</a>

<style>
  .wa-fab {
    position: fixed;
    right: var(--gutter);
    bottom: calc(var(--gutter) + env(safe-area-inset-bottom, 0px));
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.85rem 1.1rem;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    text-decoration: none;
    box-shadow: var(--shadow-float);
    transition:
      transform 0.3s var(--ease-out-expo),
      opacity 0.3s ease;
  }
  .wa-fab:active {
    transform: scale(0.95);
  }
  /* desktop: round chat bubble, label as tooltip */
  @media (min-width: 1024px) {
    .wa-fab {
      width: 3.4rem;
      height: 3.4rem;
      padding: 0;
      justify-content: center;
      background: var(--bg);
      color: var(--fg);
      border: var(--hairline);
    }
    .wa-fab:hover {
      background: var(--fg);
      color: var(--bg);
    }
    .wa-fab span {
      display: none;
    }
    .wa-fab svg {
      width: 22px;
      height: 22px;
    }
  }
  :global(.menu-open) .wa-fab {
    opacity: 0;
    pointer-events: none;
  }
</style>
