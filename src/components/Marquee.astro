---
/**
 * Endless horizontal ticker (issue #6). Speeds up with scroll velocity (motion/interactions.ts).
 * Static, wrapped list with reduced motion.
 */
interface Props {
  items: string[];
  separator?: string;
  label?: string;
  variant?: 'outline' | 'band';
}
const { items, separator = '✦', label, variant = 'outline' } = Astro.props;
---

<div class:list={['marquee', `marquee--${variant}`]} data-marquee role="region" aria-label={label}>
  <div class="marquee-track">
    {
      [0, 1].map((copy) => (
        <ul class="marquee-group" aria-hidden={copy === 1 ? 'true' : undefined}>
          {items.map((item) => (
            <li>
              <span class="marquee-item">{item}</span>
              <span class="marquee-sep" aria-hidden="true">
                {separator}
              </span>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    border-block: var(--hairline);
    padding-block: clamp(1rem, 2vw, 1.5rem);
    user-select: none;
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 38s linear infinite;
  }
  .marquee-group {
    display: flex;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .marquee-group li {
    display: flex;
    align-items: center;
  }
  .marquee-item {
    padding-inline: clamp(1rem, 2.5vw, 2.5rem);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 1rem + 4vw, 5rem);
    line-height: 1;
    letter-spacing: var(--tracking-tightest);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .marquee--band {
    background: var(--fg);
    color: var(--bg);
    border: 0;
  }
  .marquee--band .marquee-item {
    font-size: clamp(1.75rem, 1rem + 3vw, 3.75rem);
    text-transform: none;
  }
  .marquee--band li:nth-child(even) .marquee-item {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .marquee--band .marquee-sep {
    color: color-mix(in srgb, var(--bg) 55%, transparent);
  }
  .marquee--outline .marquee-group li:nth-child(even) .marquee-item {
    color: var(--bg);
    -webkit-text-stroke: 3px var(--fg);
    paint-order: stroke fill;
  }
  .marquee-sep {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 0.8rem + 1vw, 1.5rem);
    color: var(--muted);
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      width: auto;
    }
    .marquee-group {
      flex-wrap: wrap;
      row-gap: var(--space-3);
    }
    .marquee-group[aria-hidden] {
      display: none;
    }
  }
</style>
