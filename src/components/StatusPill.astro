---
/** "Taking new students" status pill with a pulsing green dot (the site's only colour). */
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { waLink } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<a class="pill" href={waLink(lang)} target="_blank" rel="noopener" data-cursor="WA">
  <span class="dot" aria-hidden="true"></span>
  {t('status.available')}
</a>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 1rem 0.45rem 0.7rem;
    border: var(--hairline);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(8px);
    color: var(--fg);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition:
      border-color var(--dur-base) ease,
      transform 0.35s var(--ease-out-expo);
  }
  .pill:hover {
    border-color: var(--fg);
  }
  .dot {
    position: relative;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--status);
  }
  .dot::after {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    background: var(--status);
    opacity: 0.35;
    animation: pulse 2s ease-out infinite;
  }
  @keyframes pulse {
    from {
      transform: scale(0.4);
      opacity: 0.5;
    }
    to {
      transform: scale(1.6);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dot::after {
      animation: none;
    }
  }
</style>
