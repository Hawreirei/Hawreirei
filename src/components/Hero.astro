---
/**
 * Homepage hero (issues #4, #6). Two background options for the owner to choose from:
 *   variant="surface" — rotating 3D wireframe wave surface
 *   variant="plane"   — coordinate plane, morphing function, cursor-following tangent
 *   variant="mix"     — owner's choice: surface on screens ≥768px, plane on phones
 */
import BracketLabel from './BracketLabel.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  variant?: 'surface' | 'plane' | 'mix';
  next?: string;
}
const { lang, variant = 'surface', next = '#doors' } = Astro.props;
const t = useTranslations(lang);
---

<section class:list={['hero', `hero--${variant}`]} data-hero>
  <canvas class="hero-canvas" data-hero-canvas={variant} aria-hidden="true"></canvas>
  <div class="vignette" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-top label">
      <div>
        <p class="fg">{t('hero.edition')}</p>
        <p>{t('hero.disciplines')}</p>
      </div>
      <div class="hero-top-right">
        <p>{t('hero.location')}</p>
        <p class="fg" data-clock="Asia/Jakarta" data-clock-label="WIB">WIB --:--:--</p>
      </div>
    </div>

    <div class="hero-main">
      <div class="hero-kicker label">
        <span>[ 000 ]</span>
        <span class="rule" aria-hidden="true"></span>
        <span>{t('hero.kicker')}</span>
      </div>

      <h1 class="display hero-title" data-reveal="manual">
        <span class="reveal-mask"><span class="reveal-line" style="--i: 0">Itman</span></span>
        <span class="reveal-mask indent"><span class="reveal-line outline" style="--i: 1">Arif</span></span>
        <span class="reveal-mask"><span class="reveal-line" style="--i: 2">Hariri</span></span>
      </h1>

      <div class="g12 hero-sub">
        <p class="lead fade-up" style="--span: 5; --start: 8; --i: 4">{t('home.mission')}</p>
      </div>
    </div>

    <div class="hero-bottom label">
      <div class="hero-bottom-left">
        <span>{t('hero.selected')}</span>
        <span class="hide-sm" aria-hidden="true">/</span>
        <span class="hide-sm">{t('hero.explore')}</span>
      </div>
      <a class="descend fg" href={next} data-cursor="↓">
        <span>{t('hero.scroll')}</span>
        <span class="scroll-line" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: flex;
    overflow: hidden;
    border-bottom: var(--hairline);
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }
  .hero--plane .vignette {
    background: radial-gradient(ellipse at 30% 55%, color-mix(in srgb, var(--bg) 55%, transparent) 10%, transparent 60%);
  }
  @media (max-width: 767px) {
    .hero--mix .vignette {
      background: radial-gradient(ellipse at 30% 55%, color-mix(in srgb, var(--bg) 55%, transparent) 10%, transparent 60%);
    }
  }
  .vignette {
    z-index: 1;
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: var(--space-5);
  }
  .fg {
    color: var(--fg);
  }
  .hero-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    line-height: 1.9;
  }
  @media (min-width: 640px) {
    .hero-top-right {
      text-align: right;
    }
  }
  .hero-main {
    padding-block: var(--space-6);
  }
  .hero-kicker {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    letter-spacing: var(--tracking-wide);
  }
  .hero-kicker > span {
    white-space: nowrap;
  }
  .rule {
    width: 3rem;
    height: 1px;
    background: var(--border);
  }
  @media (max-width: 639px) {
    .rule {
      width: 1.25rem;
    }
    .hero-kicker {
      letter-spacing: var(--tracking-label);
    }
  }
  .hero-title {
    font-size: clamp(3.5rem, 12.2vw, 14rem);
    user-select: none;
  }
  @media (min-width: 640px) {
    .indent {
      padding-left: 12vw;
    }
  }
  .hero-sub {
    margin-top: var(--space-6);
  }
  .hero-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
  }
  .hero-bottom-left {
    display: flex;
    gap: var(--space-5);
  }
  @media (max-width: 639px) {
    .hide-sm {
      display: none;
    }
  }
  .descend {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    transition: letter-spacing 0.3s var(--ease-out-expo);
  }
  .descend:hover {
    letter-spacing: var(--tracking-wide);
  }
</style>
