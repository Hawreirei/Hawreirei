---
/** Bordered button that inverts on hover. Renders <a> when href is given. */
interface Props {
  href?: string;
  variant?: 'outline' | 'solid';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'outline', size = 'md', type = 'button', class: className, ...rest } = Astro.props;
const classes = ['btn', `btn-${variant}`, `btn-${size}`, className];
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <slot />
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--dur-base) var(--ease-out-expo),
      color var(--dur-base) var(--ease-out-expo),
      border-color var(--dur-base) var(--ease-out-expo),
      letter-spacing var(--dur-base) var(--ease-out-expo);
  }
  .btn-sm {
    padding: 0.4rem 0.75rem;
  }
  .btn-md {
    padding: 0.75rem 1.25rem;
  }
  .btn-lg {
    padding: 1.15rem 1.75rem;
    font-size: var(--text-sm);
  }
  .btn-solid {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  .btn:hover {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  .btn-solid:hover {
    background: transparent;
    color: var(--fg);
  }
</style>
