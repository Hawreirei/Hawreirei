---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizedPath } from '../i18n/utils';
---

<BaseLayout lang="id" title="404">
  <section class="wrap" style="padding-block: 6rem;">
    <p class="mono">Error — 404</p>
    <h1 style="font-size: clamp(4rem, 20vw, 14rem); line-height: 0.9; margin: 1rem 0; font-weight: 900;">404</h1>
    <p>Halaman tidak ditemukan · Page not found</p>
    <p><a href={localizedPath('id')}>Beranda</a> · <a href={localizedPath('en')}>Home</a></p>
  </section>
</BaseLayout>
