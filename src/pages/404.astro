---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizedPath } from '../i18n/utils';
---

<BaseLayout lang="id" title="404">
  <section class="container" style="padding-block: 6rem;">
    <p class="label">[ Error — 404 ]</p>
    <h1 class="display display-hero" style="margin-block: 1.5rem;">404</h1>
    <p>Halaman tidak ditemukan · Page not found</p>
    <p><a href={localizedPath('id')}>Beranda</a> · <a href={localizedPath('en')}>Home</a></p>
  </section>
</BaseLayout>
