---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Card from '../../components/Card.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import type { Lang } from '../../i18n/ui';
import { langs, useTranslations, localizedPath } from '../../i18n/utils';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const id = lang === 'id';

// Hero background (owner's choice, issue #4): 3D surface on screens ≥768px, function plane on phones.
const HERO_VARIANT = 'mix' as const;

// Placeholder doors — real pages arrive in issues #8, #9 and #13; full homepage in #6.
const doors = [
  { n: '001', key: 'hire', path: 'hire', viz: 'squares', span: 7, start: 1, drop: '0', ratio: '16 / 10', parallax: '0.03' },
  { n: '002', key: 'learn', path: 'learn', viz: 'lissajous', span: 5, start: 8, drop: '9rem', ratio: '1 / 1', parallax: '-0.04' },
  { n: '003', key: 'resources', path: 'resources', viz: 'phyllotaxis', span: 6, start: 2, drop: '0', ratio: '16 / 10', parallax: '-0.03' },
] as const;
---

<BaseLayout lang={lang}>
  <Hero lang={lang} variant={HERO_VARIANT} />

  <section class="section" id="doors">
    <div class="container">
      <div class="fade-up">
        <SectionHeader index="001" label={id ? 'Tiga pintu' : 'Three doors'} note={id ? 'Pilih jalur Anda' : 'Choose your path'}>
          {id ? 'Rekrut. Belajar. Sumber.' : 'Hire. Learn. Resources.'}
        </SectionHeader>
      </div>
      <div class="g12 doors">
        {
          doors.map((d, i) => (
            <div style={`--span: ${d.span}; --start: ${d.start}; --drop: ${d.drop}`} data-parallax={d.parallax}>
              <div class="fade-up" style={`--i: ${i}`}>
                <Card
                  href={localizedPath(lang, d.path)}
                  index={d.n}
                  title={t(`home.door.${d.key}`)}
                  meta={t(`home.door.${d.key}.desc`)}
                  viz={d.viz}
                  ratio={d.ratio}
                  tag={id ? 'Buka' : 'Open'}
                >
                  {t(`home.door.${d.key}.desc`)}
                </Card>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .doors {
    margin-top: clamp(4rem, 8vw, 6rem);
    row-gap: clamp(4rem, 8vw, 8rem);
    align-items: start;
  }
</style>
