---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../i18n/ui';
import { langs, useTranslations, localizedPath } from '../../i18n/utils';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

// Placeholder doors — real pages arrive in issues #8, #9 and #13.
const doors = [
  { n: '01', key: 'hire', path: 'hire' },
  { n: '02', key: 'learn', path: 'learn' },
  { n: '03', key: 'resources', path: 'resources' },
] as const;
---

<BaseLayout lang={lang}>
  <section class="hero container">
    <p class="label">[ 000 — {t('home.role')} ]</p>
    <h1 class="display display-hero">Itman<br /><span class="outline">Arif</span><br />Hariri</h1>
    <p class="mission lead muted">{t('home.mission')}</p>
  </section>

  <section class="doors container" aria-label={lang === 'id' ? 'Tiga pintu' : 'Three doors'}>
    {
      doors.map((d) => (
        <a class="door" href={localizedPath(lang, d.path)}>
          <span class="mono">{d.n} /</span>
          <strong>{t(`home.door.${d.key}`)}</strong>
          <span class="desc">{t(`home.door.${d.key}.desc`)}</span>
        </a>
      ))
    }
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(3rem, 10vw, 8rem) clamp(2rem, 6vw, 4rem);
  }
  .hero h1 {
    margin-block: var(--space-5);
  }
  .mission {
    max-width: 34ch;
  }
  .doors {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
    padding-bottom: 4rem;
  }
  .door {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
    border: var(--hairline);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    min-height: 11rem;
    transition: background 0.2s, color 0.2s;
  }
  .door strong {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    text-transform: uppercase;
    letter-spacing: var(--tracking-tight);
    margin-top: auto;
  }
  .door .desc {
    color: var(--muted);
  }
  .door:hover {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  .door:hover .desc {
    color: inherit;
  }
</style>
