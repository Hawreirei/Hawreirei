---
/** Apps page: the owner's selected web apps, each with screenshot, description, demo and code links. */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BracketLabel from '../../components/BracketLabel.astro';
import type { Lang } from '../../i18n/ui';
import { langs, useTranslations } from '../../i18n/utils';
import { apps } from '../../data/apps';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const id = lang === 'id';
const pad = (n: number) => String(n).padStart(3, '0');
---

<BaseLayout
  lang={lang}
  title={t('nav.apps')}
  description={id
    ? 'Aplikasi web buatan Itman Arif Hariri untuk kelas matematika: teka-teki pecahan, game faktor, dan balapan perkalian.'
    : 'Web apps by Itman Arif Hariri for the math classroom: fraction puzzles, factor games and times-table races.'}
>
  <section class="section page-head">
    <div class="container">
      <BracketLabel index="000" text={id ? 'Aplikasi buatan saya' : 'Apps I built'} />
      <h1 class="display page-title" data-reveal>
        <span class="reveal-mask"><span class="reveal-line" style="--i: 0">{id ? 'Aplikasi' : 'Apps'}</span></span>
        <span class="reveal-mask"><span class="reveal-line serif" style="--i: 1">{id ? 'untuk kelas.' : 'for class.'}</span></span>
      </h1>
      <div class="g12">
        <p class="lead muted fade-up" style="--span: 6; --start: 7; --i: 2">
          {
            id
              ? 'Saya membuat aplikasi web kecil untuk kelas saya sendiri — gratis, langsung jalan di browser, tanpa akun. Silakan dicoba.'
              : 'I build small web apps for my own classroom — free, running right in the browser, no account needed. Try them out.'
          }
        </p>
      </div>
    </div>
  </section>

  {
    apps.map((app, i) => (
      <section class="section app" id={app.slug} aria-labelledby={`${app.slug}-title`}>
        <div class:list={['container', 'g12', 'app-grid', { flip: i % 2 === 1 }]}>
          <div class="app-shot fade-up" style={i % 2 ? '--span: 7; --start: 6' : '--span: 7'} data-parallax={i % 2 ? '-0.02' : '0.02'}>
            <a class="shot-frame" href={app.demo} target="_blank" rel="noopener" data-tilt data-cursor="PLAY" tabindex="-1" aria-hidden="true">
              <span class="shot-bar mono">
                <span class="dots"><i /><i /><i /></span>
                <span class="shot-url">{app.demo.replace('https://', '')}</span>
              </span>
              <Image src={app.image} alt="" widths={[640, 960, 1440]} sizes="(min-width: 1024px) 58vw, 100vw" />
              <span class="card-glare" aria-hidden="true" />
            </a>
          </div>
          <div class="app-text fade-up" style={i % 2 ? '--span: 4; --start: 1; --i: 1' : '--span: 4; --start: 9; --i: 1'}>
            <p class="label">{pad(i + 1)} / {app.kind[lang]}</p>
            <h2 class="h2" id={`${app.slug}-title`} data-roll>{app.title}</h2>
            <p class="app-desc">{app.description[lang]}</p>
            <p class="label">[ {app.tags[lang].join(' / ')} ]</p>
            <div class="app-links">
              <a class="btn-solid mono" href={app.demo} target="_blank" rel="noopener" data-cursor="PLAY" data-magnetic-btn>
                {t('apps.demo')} <span aria-hidden="true">↗</span>
              </a>
              <a class="btn-line mono" href={app.code} target="_blank" rel="noopener" data-cursor="CODE">
                {t('apps.code')} <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </div>
      </section>
    ))
  }
</BaseLayout>


<style>
  .page-head .container {
    display: grid;
    gap: var(--space-6);
  }
  .page-title {
    font-size: clamp(2.5rem, 11vw, 12rem);
  }
  .app-grid {
    align-items: center;
    row-gap: var(--space-6);
  }
  @media (min-width: 1024px) {
    .flip .app-shot {
      order: 2;
    }
  }
  .app-shot {
    perspective: 1400px;
  }
  .shot-frame {
    position: relative;
    display: block;
    overflow: hidden;
    border: var(--hairline);
    border-radius: var(--radius);
    background: var(--surface);
    transform-style: preserve-3d;
    transition:
      transform var(--dur-fast) var(--ease-snap),
      border-color var(--dur-base) ease,
      box-shadow var(--dur-base) ease;
  }
  .shot-frame:hover {
    border-color: var(--fg);
    box-shadow: var(--shadow-float);
  }
  .shot-frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .shot-bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: 0.6rem 1rem;
    border-bottom: var(--hairline);
    background: var(--bg);
    color: var(--muted);
  }
  .dots {
    display: flex;
    gap: 5px;
  }
  .dots i {
    width: 7px;
    height: 7px;
    border: 1px solid var(--muted);
    border-radius: 50%;
  }
  .shot-url {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-transform: none;
    letter-spacing: 0.04em;
  }
  .card-glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), rgba(255, 255, 255, 0.18), transparent 60%);
    transition: opacity 0.35s ease;
  }
  .shot-frame:hover .card-glare {
    opacity: 1;
  }
  .app-text {
    display: grid;
    gap: var(--space-4);
    align-content: center;
  }
  .app-desc {
    line-height: 1.7;
  }
  .app-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .btn-solid,
  .btn-line {
    display: inline-flex;
    gap: var(--space-2);
    padding: 0.9rem 1.25rem;
    border: 1px solid var(--fg);
    border-radius: var(--radius);
    font-size: var(--text-label);
    text-decoration: none;
    transition:
      background-color var(--dur-base) ease,
      color var(--dur-base) ease,
      transform 0.35s var(--ease-out-expo);
  }
  .btn-solid {
    background: var(--fg);
    color: var(--bg);
  }
  .btn-solid:hover {
    background: transparent;
    color: var(--fg);
  }
  .btn-line {
    color: var(--fg);
  }
  .btn-line:hover {
    background: var(--fg);
    color: var(--bg);
  }
</style>
