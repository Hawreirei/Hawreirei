---
/** "Learn with me" (issue #9): five tutoring programmes, how lessons work, FAQ. Copy is placeholder for owner review. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import BracketLabel from '../../components/BracketLabel.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import StatusPill from '../../components/StatusPill.astro';
import type { Lang } from '../../i18n/ui';
import { langs, useTranslations, localizedPath } from '../../i18n/utils';
import { programmes, journey, faq } from '../../data/programmes';
import { waLink } from '../../data/site';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const id = lang === 'id';
const pad = (n: number) => String(n).padStart(2, '0');
const askMessage = (title: string) =>
  id ? `Halo, saya ingin bertanya tentang program ${title}.` : `Hello, I'd like to ask about the ${title} programme.`;
---

<BaseLayout
  lang={lang}
  title={t('nav.learn')}
  description={id
    ? 'Les matematika bersama Itman Arif Hariri: Primary, Pearson Edexcel, Achievement Test, TKA · UTBK · CASN, dan olimpiade.'
    : 'Math tutoring with Itman Arif Hariri: Primary, Pearson Edexcel, Achievement Tests, TKA · UTBK · CASN, and olympiad.'}
>
  <!-- Page head -->
  <section class="section page-head">
    <div class="container head-grid">
      <BracketLabel index="000" text={id ? 'Program les' : 'Tutoring programmes'} />
      <h1 class="display page-title" data-reveal>
        <span class="reveal-mask"><span class="reveal-line" style="--i: 0">{id ? 'Belajar' : 'Learn'}</span></span>
        <span class="reveal-mask"><span class="reveal-line serif" style="--i: 1">{id ? 'bersama saya.' : 'with me.'}</span></span>
      </h1>
      <div class="g12">
        <div class="head-side fade-up" style="--span: 6; --start: 7; --i: 2">
          <p class="lead muted">
            {
              id
                ? 'Lima program, satu cara: pahami konsepnya dulu, lalu latihan sampai lancar. Pilih program di bawah, atau langsung tanya lewat WhatsApp.'
                : 'Five programmes, one approach: understand the concept first, then practise until it flows. Pick a programme below, or just ask on WhatsApp.'
            }
          </p>
          <StatusPill lang={lang} />
        </div>
      </div>
      <nav class="prog-nav fade-up" aria-label={id ? 'Daftar program' : 'Programme list'}>
        {
          programmes.map((p, i) => (
            <a href={`#${p.slug}`} class="prog-chip mono" data-cursor="GO">
              <span class="muted">{pad(i + 1)}</span> {p.title[lang]}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <!-- Programmes -->
  {
    programmes.map((p, i) => (
      <section class="section prog" id={p.slug} aria-labelledby={`${p.slug}-title`}>
        <div class:list={['container', 'g12', 'prog-grid', { flip: i % 2 === 1 }]}>
          <div class="prog-visual fade-up" style={i % 2 ? '--span: 5; --start: 8' : '--span: 5'} data-parallax={i % 2 ? '-0.02' : '0.02'}>
            <div class="viz-frame">
              <span class="viz-bar mono">
                <span>{pad(i + 1)} / {pad(programmes.length)}</span>
                <span class="muted">{p.meta[lang]}</span>
              </span>
              <canvas data-mathviz={p.viz} aria-hidden="true" />
            </div>
          </div>
          <div class="prog-text fade-up" style={i % 2 ? '--span: 6; --start: 1; --i: 1' : '--span: 6; --start: 7; --i: 1'}>
            <p class="label">( {pad(i + 1)} ) {p.meta[lang]}</p>
            <h2 class="h2" id={`${p.slug}-title`} data-roll>
              {p.title[lang]}
            </h2>
            <p class="prog-intro">{p.intro[lang]}</p>
            <ul class="topics">
              {p.topics[lang].map((topic) => (
                <li>
                  <span class="mono muted" aria-hidden="true">
                    →
                  </span>{' '}
                  {topic}
                </li>
              ))}
            </ul>
            <div class="prog-cta">
              <a class="btn-solid mono" href={waLink(lang, askMessage(p.title[lang]))} target="_blank" rel="noopener" data-cursor="WA" data-magnetic-btn>
                {id ? 'Tanya program ini' : 'Ask about this'} <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <!-- How lessons work -->
  <section class="section" aria-labelledby="journey-title">
    <div class="container">
      <div class="fade-up">
        <SectionHeader index="006" label={id ? 'Alur belajar' : 'How it works'} note={id ? 'Empat langkah' : 'Four steps'} id="journey-title">
          {id ? 'Cara les ' : 'How lessons '}<span class="serif">{id ? 'berjalan.' : 'work.'}</span>
        </SectionHeader>
      </div>
      <ol class="steps">
        {
          journey.map((s, i) => (
            <li class="step fade-up" style={`--i: ${i}`}>
              <span class="label">( {pad(i + 1)} )</span>
              <h3 class="step-title">{s.title[lang]}</h3>
              <p class="muted">{s.text[lang]}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq" aria-labelledby="faq-title">
    <div class="container g12 faq-grid">
      <div class="fade-up faq-intro" style="--span: 5">
        <BracketLabel index="007" text="FAQ" />
        <h2 class="h2" id="faq-title" data-roll>
          {id ? 'Pertanyaan ' : 'Common '}<span class="serif">{id ? 'umum.' : 'questions.'}</span>
        </h2>
        <p class="muted faq-note">
          {id ? 'Pertanyaan lain? ' : 'Something else? '}
          <a href={localizedPath(lang, 'contact')}>{id ? 'Hubungi saya' : 'Get in touch'} →</a>
        </p>
      </div>
      <div class="faq-list fade-up" style="--span: 6; --start: 7; --i: 1">
        {
          faq.map((item) => (
            <details class="faq-item">
              <summary data-cursor="?">
                <span>{item.q[lang]}</span>
                <span class="plus" aria-hidden="true">
                  +
                </span>
              </summary>
              <p class="faq-answer">{item.a[lang]}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .head-grid {
    display: grid;
    gap: var(--space-6);
  }
  .page-title {
    font-size: clamp(2.5rem, 11vw, 12rem);
  }
  .page-title .serif {
    font-size: 1.05em;
  }
  .head-side {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .prog-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .prog-chip {
    padding: 0.55rem 1rem;
    border: var(--hairline);
    border-radius: var(--radius-pill);
    color: var(--fg);
    text-decoration: none;
    transition:
      background-color var(--dur-base) ease,
      color var(--dur-base) ease,
      border-color var(--dur-base) ease;
  }
  .prog-chip:hover {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  .prog-chip:hover .muted {
    color: inherit;
  }

  .prog {
    scroll-margin-top: var(--header-h);
  }
  .prog-grid {
    align-items: center;
  }
  @media (min-width: 1024px) {
    .flip .prog-visual {
      order: 2;
    }
  }
  .viz-frame {
    overflow: hidden;
    border: var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .viz-bar {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 0.8rem 1.1rem;
    border-bottom: var(--hairline);
  }
  .viz-frame canvas {
    width: 100%;
    aspect-ratio: 1 / 1;
  }
  .prog-text {
    display: grid;
    gap: var(--space-5);
    align-content: center;
  }
  .prog-intro {
    font-size: var(--text-lg);
    line-height: 1.6;
    max-width: 48ch;
  }
  .topics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-3) var(--space-5);
    margin: 0;
    padding: var(--space-5) 0 0;
    list-style: none;
    border-top: var(--hairline);
  }
  .prog-cta {
    margin-top: var(--space-2);
  }
  .btn-solid {
    display: inline-flex;
    gap: var(--space-2);
    padding: 0.95rem 1.4rem;
    border: 1px solid var(--fg);
    border-radius: var(--radius-pill);
    background: var(--fg);
    color: var(--bg);
    font-size: var(--text-label);
    text-decoration: none;
    transition:
      background-color var(--dur-base) ease,
      color var(--dur-base) ease,
      transform 0.35s var(--ease-out-expo);
  }
  .btn-solid:hover {
    background: transparent;
    color: var(--fg);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-4);
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .step {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    min-height: 13rem;
    padding: var(--space-6) var(--space-5);
    border: var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--surface);
    transition:
      background-color var(--dur-base) ease,
      color var(--dur-base) ease,
      transform 0.4s var(--ease-out-expo);
  }
  .step:hover {
    background: var(--fg);
    color: var(--bg);
    transform: translateY(-4px);
  }
  .step:hover .muted,
  .step:hover .label {
    color: color-mix(in srgb, var(--bg) 70%, var(--fg));
  }
  .step-title {
    margin-top: auto;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
    text-transform: uppercase;
    letter-spacing: var(--tracking-tight);
  }

  .faq-grid {
    align-items: start;
  }
  .faq-grid .h2 {
    margin-top: var(--space-5);
    /* narrow column: "PERTANYAAN" (~11.5em wide in Syne) must fit at every width */
    font-size: clamp(1.5rem, 0.4rem + 2.4vw, 3.25rem);
  }
  .faq-note {
    margin-top: var(--space-5);
  }
  .faq-note a {
    color: var(--fg);
  }
  .faq-list {
    border-top: var(--hairline);
  }
  .faq-item {
    border-bottom: var(--hairline);
  }
  .faq-item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-5);
    font-size: var(--text-lg);
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .plus {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 1.25rem;
    transition: transform 0.3s var(--ease-out-expo);
  }
  .faq-item[open] .plus {
    transform: rotate(45deg);
  }
  .faq-answer {
    max-width: 58ch;
    padding-bottom: var(--space-5);
    color: var(--muted);
    line-height: 1.7;
  }
</style>
